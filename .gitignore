# --- Copyright firewall: never commit source PDFs or rendered plates ---
corpus/**
!corpus/.gitkeep
!corpus/README.md
**/*.plate.png
.cache/

# --- Local-only derived artifacts (vectors, caches): never shared ---
index/

# (The shareable derived product — bundle/catalog.jsonl — is NOT ignored: it is facts only,
#  committed and distributable so others can drop in their own copy of the source PDFs.)

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# --- Models / weights pulled locally ---
models/
*.gguf

# --- Claude Code personal overrides (project settings.json may be committed) ---
.claude/settings.local.json

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Secrets ---
.env
.env.*
!.env.example
