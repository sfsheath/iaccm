# Copy to .env and edit. The app talks to any OpenAI-compatible endpoint.
# All paths are RELATIVE to the project root (the folder containing pyproject.toml),
# or override IACCM_ROOT to point elsewhere. Nothing is hardcoded.

# --- Default: local Ollama (cross-platform; macOS Metal / Windows) ---
IACCM_MODEL_PROVIDER=ollama
IACCM_MODEL_BASE_URL=http://localhost:11434/v1
IACCM_MODEL_NAME=qwen2.5-vl:7b
IACCM_MODEL_API_KEY=ollama   # Ollama ignores the key but the client requires one

# --- Alternative: remote open-weights via an OpenAI-compatible provider ---
# IACCM_MODEL_PROVIDER=remote
# IACCM_MODEL_BASE_URL=https://openrouter.ai/api/v1
# IACCM_MODEL_NAME=qwen/qwen-2.5-vl-72b-instruct
# IACCM_MODEL_API_KEY=sk-...

# --- Paths (relative to root by default; uncomment to override) ---
# IACCM_ROOT=.
# IACCM_CORPUS_DIR=corpus
# IACCM_INDEX_DIR=index
