# Copy to .env and edit. All paths are RELATIVE to the project root (the folder containing
# pyproject.toml), or override IACCM_ROOT to point elsewhere. Nothing is hardcoded.

# --- Default: Claude (cloud) via the official Anthropic SDK ---
IACCM_MODEL_PROVIDER=anthropic
IACCM_MODEL_NAME=claude-opus-4-8
# Keys can go straight in this file (it is gitignored) — per-provider names are read directly:
ANTHROPIC_API_KEY=sk-ant-...
# (IACCM_MODEL_API_KEY is a generic fallback if you prefer one knob; leave blank when using the
# per-provider names above.)
IACCM_MODEL_API_KEY=

# --- Cheaper open-weight option: Featherless (or any OpenAI-compatible endpoint) ---
# Switch per run with the CLI flag instead of editing this file:
#     iaccm id "..." --image sherd.jpg --provider featherless --model <a-vision-model>
#     iaccm ingest ... --provider featherless          (uses the live path; Batch API is Anthropic-only)
# Keys are read per provider, so keep several here and switch with --provider:
# FEATHERLESS_API_KEY=...          # used automatically when --provider featherless
# The endpoint defaults to https://api.featherless.ai/v1 for provider=featherless (override with
# IACCM_MODEL_BASE_URL). You MUST choose a VISION-capable model — this tool reads plate images and
# sherd photos; a text-only model will not work, and an open VLM is generally weaker than Claude at
# fine plate-reading / decoration comparison, so verify quality on a few cases before bulk use.
# IACCM_MODEL_PROVIDER=featherless
# IACCM_MODEL_NAME=Qwen/Qwen2.5-VL-72B-Instruct   # example; use a model Featherless actually serves

# --- Local Ollama (also OpenAI-compatible) ---
# IACCM_MODEL_PROVIDER=ollama
# IACCM_MODEL_NAME=qwen2.5-vl:7b
# IACCM_MODEL_API_KEY=ollama   # Ollama ignores the key but the client requires one

# --- Paths (relative to root by default; uncomment to override) ---
# IACCM_ROOT=.
# IACCM_CORPUS_DIR=corpus
# IACCM_INDEX_DIR=index
